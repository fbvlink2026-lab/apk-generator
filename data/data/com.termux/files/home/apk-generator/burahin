#!/bin/bash
# ==========================================
# 🔄 FRESH START — DIRETSYONG BUBURA
# ✅ PANANATILIHIN: docs/, README.md, errors.md, .github/workflows/build.yml
# ❌ BUBURAHIN: LAHAT NG IBA
# ==========================================

REPO_DIR="$HOME/apk-generator"
cd "$REPO_DIR" || exit 1

# BURAHIN ANG apps/
[ -d "apps" ] && rm -rf apps

# BURAHIN ANG MGA FILE SA UGAT
rm -f BASAHIN.html FILE-MANAGER.html MARTODOSCO-UPDATE.md

# BURAHIN ANG LAHAT SA workflows/ MALIBAN SA build.yml
if [ -d ".github/workflows" ]; then
  cd .github/workflows
  for f in *; do [ "$f" = "build.yml" ] || rm -f "$f"; done
  cd ../..
fi

echo "✅ TAPOS NA — BINURA NA ANG LAHAT NG DAPAT BURAHIN!"
echo ""
echo "MANANATILI:"
ls -la --group-directories-first | grep -E 'docs|README.md|errors.md|.github'
echo ""
echo "👉 Ipadala na: martopush"
