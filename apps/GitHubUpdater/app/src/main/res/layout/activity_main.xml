<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:id="@+id/drawer_layout">

    <!-- 📌 STATUS BAR SA TAAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1565C0">

        <TextView
            android:id="@+id/tvCurrentVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📌 Bersyon: v5.86 — WALANG ERROR"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Handa na"
            android:textColor="#E3F2FD"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnCheckVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Tignan ang Update"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬇️ I-DOWNLOAD ANG UPDATE"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btnCloseDrawer""
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕ Isara"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#666666"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- ✅ SCROLLVIEW — LAHAT MAKAKA-SCROLL NA! -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_menu_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>

    </ScrollView>

</LinearLayout>
