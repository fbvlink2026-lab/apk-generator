<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" android:orientation="vertical" android:padding="20dp">
        <TextView android:text="🎸 M A R T O D O S K O" android:textColor="#FFD700" android:textSize="24sp" android:textStyle="bold" android:layout_gravity="center"/>
        <TextView android:text="GitHub Updater — v1.0.0" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_gravity="center" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/statusMode" android:text="🛑 MANO-MANO MODE" android:textColor="#888888" android:textSize="11sp" android:layout_gravity="center"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" android:layout_marginVertical="16dp"/>
        <TextView android:text="📋 PILIIN ANG GAGAWIN:" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <LinearLayout android:id="@+id/menuItem1" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="1" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="📤 IPADALA SA GITHUB" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem2" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="2" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="🚀 IPADALA + PATAKBUHIN AGAD" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem3" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="3" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="🖼️ PILIN ANG ICON" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem4" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="4" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="🌐 Buksan ang GitHub Repo" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem5" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="5" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="⚙️ Buksan ang GitHub Actions" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem6" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="6" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="⚡ I-ON ang AUTO-RUN" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem7" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="7" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="🛑 I-OFF ang AUTO-RUN" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem8" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="8dp">
            <TextView android:text="8" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="📋 TIGNAN ANG STATUS" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menuItem9" android:layout_width="match_parent" android:layout_height="52dp" android:background="#1E1E1E" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
            <TextView android:text="9" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold" android:width="30dp"/>
            <TextView android:text="❌ TAPOS NA / LUMABAS" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
        <View android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Created & Developed by MartoDosko\n© Copyright 2026 — All Rights Reserved" android:textColor="#555555" android:textSize="11sp" android:gravity="center" android:layout_marginTop="16dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#1A1A1A" android:orientation="vertical" android:padding="20dp">
        <TextView android:text="🔄 UPDATE PANEL" android:textColor="#FFD700" android:textSize="20sp" android:textStyle="bold"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="16dp"/>
        <TextView android:text="Current Version:" android:textColor="#888888" android:textSize="13sp"/>
        <TextView android:id="@+id/currentVersionPanel" android:text="1.0.0" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="20dp"/>
        <TextView android:text="Latest Version:" android:textColor="#888888" android:textSize="13sp"/>
        <TextView android:id="@+id/latestVersionPanel" android:text="Checking..." android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>
        <Button android:id="@+id/updateBtn" android:layout_width="match_parent" android:layout_height="56dp" android:text="🎉 New Release — Update Now" android:background="#FFD700" android:textColor="#000000" android:textSize="15sp" android:textStyle="bold" android:visibility="gone"/>
        <TextView android:id="@+id/upToDateText" android:text="✅ You are using the latest version" android:textColor="#4CAF50" android:textSize="14sp" android:visibility="gone"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
